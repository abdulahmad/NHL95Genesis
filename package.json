{
  "name": "nhl95-build",
  "version": "1.0.0",
  "description": "Build scripts for NHL 95 Genesis",
  "scripts": {
    "assets": "node tools/prebuild.js retail",
    "extractassets": "node tools/extractAssets95.js retail",
    "asm": "build95.bat",
    "fixopcodes": "node tools/fixopcodes.js \"output\\\\obj\\\\nhl95 .lst\" output\\\\obj\\\\nhl95.bin && move /y output\\\\obj\\\\modified_nhl95.bin output\\\\",
    "build:retail": "node tools/build.js retail",
    "build:dev": "node tools/build.js dev",
    "verify:retail": "node tools/verifyRom.js output/modified_nhl95.bin retail",
    "clean": "node tools/build.js --clean"
  },
  "devDependencies": {
    "asm80": "1.11.14",
    "crc-32": "^1.2.2"
  },
  "license": "ISC"
}
